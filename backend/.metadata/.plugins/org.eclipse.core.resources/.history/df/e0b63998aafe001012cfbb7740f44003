package com.isms.service;

import org.springframework.stereotype.Service;

import com.isms.entity.UserAccount;
import com.isms.reporitory.UserAccountRepository;

import lombok.RequiredArgsConstructor;

@RequiredArgsConstructor
@Service
public class UserAccountService {

	private final UserAccountRepository accountRepository;

	public UserAccount createUser(UserAccount newUserAccount) {
		return accountRepository.save(newUserAccount);
	}
}
