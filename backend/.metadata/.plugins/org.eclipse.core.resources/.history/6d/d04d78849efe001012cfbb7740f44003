package com.isms.service;

import org.springframework.stereotype.Service;

import com.isms.entity.IsmsUser;
import com.isms.entity.TenantUser;
import com.isms.entity.UserAccount;
import com.isms.reporitory.TenantRepository;

import lombok.RequiredArgsConstructor;

@RequiredArgsConstructor
@Service
public class TenantService {

	private final TenantRepository tenantRepository;

	public UserAccount createUser(UserAccount newUser) {
